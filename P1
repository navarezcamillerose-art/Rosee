
public class Labactivity3 {

    public static void main(String[] args) {

        // Create student accounts
        PrintAccount mia = new PrintAccount("Mia", 10);
        PrintAccount luis = new PrintAccount("Luis", -4);

        // Display starting credits
        System.out.println("Mia: " + mia.getCredits() + ", Luis: " + luis.getCredits());

        // Test printing pages
        System.out.println(mia.printPages(4) + "; Mia: " + mia.getCredits());
        System.out.println(mia.printPages(7) + "; Mia: " + mia.getCredits());

        // Test adding credits
        System.out.println(mia.addCredits(-3) + "; Mia: " + mia.getCredits());
        System.out.println(mia.addCredits(4) + "; Mia: " + mia.getCredits() + ", Luis: " + luis.getCredits());
    }
}

class PrintAccount {
    private String studentName;
    private int credits;

    // Constructor
    public PrintAccount(String studentName, int credits) {
        this.studentName = studentName;
        this.credits = credits < 0 ? 0 : credits;
    }

    // Add credits if positive
    public boolean addCredits(int amount) {
        if (amount > 0) {
            credits += amount;
            return true;
        }
        return false;
    }

    // Print pages if credits are enough
    public boolean printPages(int pages) {
        if (pages > 0 && credits >= pages) {
            credits -= pages;
            return true;
        }
        return false;
    }

    // Get current credits
    public int getCredits() {
        return credits;
    }
}






class LabGrade {
    String studentName;
    int quizScore;
    int labScore;

    // Constructor
    LabGrade(String studentName, int quizScore, int labScore) {
        this.studentName = studentName;
        this.quizScore = (quizScore >= 0 && quizScore <= 100) ? quizScore : 0;
        this.labScore = (labScore >= 0 && labScore <= 100) ? labScore : 0;
    }

    // Update both scores only if both are valid
    boolean updateScores(int quizScore, int labScore) {
        if (quizScore < 0 || quizScore > 100 ||
            labScore < 0 || labScore > 100) {
            return false;
        }

        this.quizScore = quizScore;
        this.labScore = labScore;
        return true;
    }

    // Calculate weighted final grade
    double getFinalGrade() {
        return (quizScore * 0.40) + (labScore * 0.60);
    }

    // Check if the student passes
    boolean isPassing() {
        return getFinalGrade() >= 75.0;
    }
}

public class Main {
    public static void main(String[] args) {

        LabGrade ana = new LabGrade("Ana", 80, 90);
        LabGrade ben = new LabGrade("Ben", 101, 85);

        System.out.println("Ana's Grade: " + ana.getFinalGrade());
        System.out.println(ana.isPassing() ? "Passing" : "Not Passing");

        System.out.println("\nBen's Grade: " + ben.getFinalGrade());
        System.out.println(ben.isPassing() ? "Passing" : "Not Passing");

        System.out.println("\nUpdate Ana's scores to 95 and 101:");
        System.out.println(ana.updateScores(95, 101));
        System.out.println("Grade: " + ana.getFinalGrade());

        System.out.println("\nUpdate Ana's scores to 74 and 75:");
        System.out.println(ana.updateScores(74, 75));
        System.out.println("Grade: " + ana.getFinalGrade());
        System.out.println(ana.isPassing() ? "Passing" : "Not Passing");

        System.out.println("\nUpdate Ana's scores to 75 and 75:");
        System.out.println(ana.updateScores(75, 75));
        System.out.println("Grade: " + ana.getFinalGrade());
        System.out.println(ana.isPassing() ? "Passing" : "Not Passing");

        System.out.println("\nCheck Ben's record again:");
        System.out.println("Grade: " + ben.getFinalGrade());
        System.out.println(ben.isPassing() ? "Passing" : "Not Passing");
    }
}
