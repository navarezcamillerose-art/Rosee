
public class PrintAccount {

    // Private attributes store each student's account information.
    // Private means these values cannot be accessed directly
    // from the Main class.
    private String studentName;
    private int credits;


    // CONSTRUCTOR
    // This runs automatically when a new PrintAccount object is created.
    public PrintAccount(String studentName, int credits) {

        // Store the student's name in the object's studentName field.
        // "this.studentName" refers to the field.
        // "studentName" refers to the constructor parameter.
        this.studentName = studentName;

        // Check if the starting credits are negative.
        // An account must never start with negative credits.
        if (credits < 0) {
            this.credits = 0;
        } else {
            // If the credits are valid, store the given amount.
            this.credits = credits;
        }
    }


    // ADD CREDITS METHOD
    // Adds credits to the student's printing account.
    // Returns true if successful and false if unsuccessful.
    public boolean addCredits(int amount) {

        // Only positive amounts are accepted.
        if (amount <= 0) {

            // Reject the operation.
            // The existing credits will remain unchanged.
            return false;
        }

        // Add the accepted amount to the current credits.
        this.credits += amount;

        // Inform the Main class that the operation succeeded.
        return true;
    }


    // PRINT PAGES METHOD
    // Each printed page costs exactly one credit.
    public boolean printPages(int pages) {

        // Check whether the requested page count is valid
        // and whether the account has enough credits.
        if (pages <= 0 || pages > this.credits) {

            // Reject the operation if either condition is true.
            // Credits will not be deducted.
            return false;
        }

        // Deduct the number of pages from the available credits.
        this.credits -= pages;

        // Return true because the printing request was successful.
        return true;
    }


    // GET CREDITS METHOD
    // Allows other classes to view the current credits.
    // It does not change the account balance.
    public int getCredits() {
        return this.credits;
    }


    // GET STUDENT NAME METHOD
    // Returns the name of the account owner.
    public String getStudentName() {
        return this.studentName;
    }
}













public class PrintAccount {

    // Private attributes
    private String studentName;
    private int credits;

    // Constructor
    public PrintAccount(String studentName, int credits) {
        this.studentName = studentName;
        this.credits = (credits < 0) ? 0 : credits;
    }

    // Add credits if the amount is positive
    public boolean addCredits(int amount) {
        if (amount <= 0) {
            return false;
        }

        this.credits += amount;
        return true;
    }

    // Print pages if enough credits are available
    public boolean printPages(int pages) {
        if (pages <= 0 || pages > this.credits) {
            return false;
        }

        this.credits -= pages;
        return true;
    }

    // Return current credits
    public int getCredits() {
        return this.credits;
    }

    // Return student name
    public String getStudentName() {
        return this.studentName;
    }
}






public class Main {

    public static void main(String[] args) {

        // Create two accounts
        PrintAccount mia = new PrintAccount("Mia", 10);
        PrintAccount luis = new PrintAccount("Luis", -4);

        // Display starting credits
        System.out.println("Mia: " + mia.getCredits());
        System.out.println("Luis: " + luis.getCredits());

        // Test printing pages
        System.out.println("Mia prints 4 pages: "
                + mia.printPages(4));
        System.out.println("Mia: " + mia.getCredits());

        System.out.println("Mia prints 7 pages: "
                + mia.printPages(7));
        System.out.println("Mia: " + mia.getCredits());

        // Test adding credits
        System.out.println("Mia adds -3 credits: "
                + mia.addCredits(-3));
        System.out.println("Mia: " + mia.getCredits());

        System.out.println("Mia adds 4 credits: "
                + mia.addCredits(4));
        System.out.println("Mia: " + mia.getCredits());

        // Check Luis's independent account
        System.out.println("Luis: " + luis.getCredits());
    }
}



